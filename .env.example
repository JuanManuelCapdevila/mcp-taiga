# Base URL of the Taiga API (change for self-hosted instances).
TAIGA_API_URL=https://api.taiga.io/api/v1

# Credentials of the Taiga user this server acts as.
# The server only inherits whatever permissions this user already has in
# Taiga (per-project roles). Use a dedicated "bot" user with a restricted
# role in each project if you want to limit what this MCP server can do.
TAIGA_USERNAME=
TAIGA_PASSWORD=
