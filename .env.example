# Base URL of the Taiga API (required). Use https://api.taiga.io/api/v1 for
# Taiga Cloud, or your self-hosted instance's own /api/v1 path.
TAIGA_API_URL=https://api.taiga.io/api/v1

# Credentials of the Taiga user this server acts as.
# The server only inherits whatever permissions this user already has in
# Taiga (per-project roles). Use a dedicated "bot" user with a restricted
# role in each project if you want to limit what this MCP server can do.
TAIGA_USERNAME=
TAIGA_PASSWORD=

# Transport: "stdio" (default, for local clients like Claude Desktop/Code) or
# "http" (for remote clients like a ChatGPT custom connector).
TRANSPORT=stdio

# Only used when TRANSPORT=http:
# Port the server listens on.
PORT=3000
# The one secret in the system: used both as the password on the OAuth login
# form AND as the static bearer token (`Authorization: Bearer <token>`) that
# clients which don't support OAuth can send directly.
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=
# Fixed OAuth client credentials for the "user-defined client" flow (e.g. ChatGPT
# custom connectors). Make these up yourself and paste the same values into the
# client's connector setup — they are not secrets a human ever types, just an
# identifier/secret pair exchanged machine-to-machine at the /token endpoint.
# Generate with: openssl rand -hex 16 (id) / openssl rand -hex 32 (secret)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Only redirect_uris starting with this prefix are accepted by /authorize.
# Defaults to ChatGPT's connector callback prefix; override for other OAuth clients.
# OAUTH_ALLOWED_REDIRECT_PREFIX=https://chatgpt.com/connector/oauth/
