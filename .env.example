# Base URL of the Taiga API (required). Use https://api.taiga.io/api/v1 for
# Taiga Cloud, or your self-hosted instance's own /api/v1 path.
TAIGA_API_URL=https://api.taiga.io/api/v1

# Credentials of the Taiga user this server acts as.
# The server only inherits whatever permissions this user already has in
# Taiga (per-project roles). Use a dedicated "bot" user with a restricted
# role in each project if you want to limit what this MCP server can do.
TAIGA_USERNAME=
TAIGA_PASSWORD=

# Transport: "stdio" (default, for local clients like Claude Desktop/Code) or
# "http" (for remote clients like a ChatGPT custom connector).
TRANSPORT=stdio

# Only used when TRANSPORT=http:
# Port the server listens on.
PORT=3000
# Shared secret remote clients must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=
